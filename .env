#------------------TRAINING------------------------
MODEL_NAME=distilgpt2 
EPOCHS=20  
LEARNING_RATE=0.0001 
BATCH_SIZE=128 # if OOM: try lower
EXPERIMENT_DIR=trainer_immigration # training cfg directory
SAVE_STEPS=500 # interval of cfg storage
LOGGING_STEPS=100 # interval of training logging
USE_CPU=False # cuda usage
USE_FP16=True # True: faster + less VRAM
CSV_FILE_PATH=./data/random.csv # training data directory
COLUMN_NAMES=Name,DOB,NRIC,Passport_Number # data columns
SAVE_PATH=immigration_small # name of tuned model

#------------------GENERATION------------------------
LOADED_MODEL_NAME=immigration_small # name of tuned model
NUMBER_OF_SAMPLES=100 # number of samples to generate
GEN_FILE_PATH=immigration_samples.csv # generated file directory 

